# MongoDB connection string (Atlas or self-hosted)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/examniti?retryWrites=true&w=majority

# Secret used to sign the admin session token. Use a long random string.
JWT_SECRET=replace-with-a-long-random-string

# Admin panel credentials. Change these before deploying.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# The admin panel URL is the folder name under app/ (default: admin-9273).
# It is intentionally not linked anywhere in the public site.
# Rename the "app/admin-9273" folder to change the path if you want a different secret URL.
